{
  "description": "Food Waste Saver (HA040) \u2014 surplus food redistribution platform. Monorepo: React client + Express/Prisma server.",
  "engines": {
    "node": ">=20"
  },
  "name": "food-waste-saver",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=client",
    "db:push": "npm run db:push --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm run test --workspace=server",
    "fetch-model": "node scripts/fetch-model.js"
  },
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ]
}