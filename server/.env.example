# Server port (single server serves API + built React client)
PORT=4000

# PostgreSQL (local machine — no cloud dependency, per PRD demo posture)
DATABASE_URL="postgresql://fws:fws_dev_password@localhost:5432/food_waste_saver?schema=public"
# Test database (used by `npm test`)
DATABASE_URL_TEST="postgresql://fws:fws_dev_password@localhost:5432/food_waste_saver_test?schema=public"

# Auth secrets — CHANGE these on the real demo machine
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"

# Pickup-code secrets (PRD FR-11) — CHANGE these on the real demo machine
PICKUP_CODE_PEPPER="change-me-pepper-at-least-32-chars"
PICKUP_CODE_ENC_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional email channel (P2, FR-24). Leave unset to disable email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Food Waste Saver <no-reply@example.local>"
