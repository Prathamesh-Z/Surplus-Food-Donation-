// Food Waste Saver (HA040) — Prisma schema
// Implements PRD v3.1, Section 7 (Data model).
// PostgreSQL is required: claim safety relies on row locks and transactions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  PROVIDER
  CLAIMER
  NGO
  ADMIN
}

// Account type vs active role: a USER account is one person who can act
// as Claimer and as Donor (backend role PROVIDER) — `role` on a USER
// account is the ACTIVE role, switchable via POST /api/auth/switch-role.
// NGO and ADMIN accounts have a fixed role. Existing rows were
// backfilled from their role (PROVIDER/CLAIMER → USER, NGO → NGO,
// ADMIN → ADMIN); the @default(USER) covers rows created before the
// backfill and is safe because switching additionally requires the
// current role to be CLAIMER or PROVIDER.
enum AccountType {
  USER
  NGO
  ADMIN
}

enum LanguagePref {
  EN
  MR
  HI
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum Category {
  COOKED_MEALS
  RAW_PRODUCE
  BAKERY
  DAIRY
  PACKAGED_FOOD
  BEVERAGES
  OTHER
}

enum DietaryType {
  VEG
  NON_VEG
  VEGAN
}

enum PortionType {
  INDIVIDUAL_MEALS
  BULK_SERVINGS
  KILOGRAMS
  LITRES
  PACKETS
}

enum ListingStatus {
  DRAFT
  LIVE
  PARTIALLY_CLAIMED
  FULLY_CLAIMED
  EXPIRED
  CANCELLED
  REMOVED_BY_ADMIN
}

enum ClaimStatus {
  CONFIRMED
  COLLECTED
  CANCELLED_ON_TIME
  CANCELLED_LATE
  EXPIRED
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_ADMIN
}

enum DestinationType {
  SHELTER
  COMMUNITY_KITCHEN
  OLD_AGE_HOME
  SCHOOL
  INDIVIDUALS
  OTHER
}

enum NotificationType {
  NEW_LISTING
  CLAIM_PLACED
  CLAIMER_ON_THE_WAY
  CLAIM_CANCELLED
  LISTING_CANCELLED
  NEAR_DEADLINE_PROVIDER
  NEAR_DEADLINE_CLAIMERS
  CLAIM_COLLECTED
  CLAIM_EXPIRED
  RECURRING_OCCURRENCE
  ADMIN_ALERT
}

enum AuditAction {
  VERIFY_NGO
  UNVERIFY_NGO
  KEEP_NGO_UNVERIFIED
  SUSPEND_USER
  UNSUSPEND_USER
  REMOVE_LISTING
}

// ─── Models ───────────────────────────────────────────────────────────────

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  mobile           String       @unique
  passwordHash     String
  role             Role
  accountType      AccountType @default(USER)
  languagePref     LanguagePref @default(EN)
  suspended        Boolean      @default(false)
  suspensionReason String?
  // Invite links: every user has a unique shareable code; invitedById
  // records who invited this user (null = organic signup). Unknown invite
  // codes at registration are ignored, never an error.
  inviteCode       String?      @unique
  invitedById      String?
  invitedBy        User?        @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers     User[]       @relation("UserInvites")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ngoProfile         NgoProfile?
  ngoDocuments       NgoDocument[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  listings           Listing[]           @relation("ProviderListings")
  claims             Claim[]             @relation("ClaimerClaims")
  recurringSchedules RecurringSchedule[]
  redistributionLogs RedistributionLog[] @relation("NgoRedistributions")
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AdminAuditLogs")
}

// NGO verification documents: certificates / registration proofs an NGO
// uploads for the admin verification workflow. Files live in a PRIVATE
// directory (never statically served); bytes are reachable only through
// the NGO's own list and the admin download endpoint.
model NgoDocument {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
}

model NgoProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationName   String
  registrationDetail String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?
  // Latest admin review decision when the NGO was KEPT unverified:
  // the optional reason shown to the NGO, and when/by whom it was
  // reviewed. A fresh document upload clears verificationReviewedAt
  // so the NGO returns to the review queue; verifying or unverifying
  // clears all three.
  verificationNote       String?
  verificationReviewedAt DateTime?
  verificationReviewedById String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Password reset (v3.6): only the SHA-256 hash of the token is stored.
// Single-use (usedAt set on success), 30-minute expiry, and a successful
// reset revokes every Session of the user.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Listing {
  id                      String        @id @default(uuid())
  providerId              String
  provider                User          @relation("ProviderListings", fields: [providerId], references: [id])
  foodName                String
  foodDetails             String
  category                Category
  dietaryType             DietaryType
  portionType             PortionType
  totalPortions           Int
  portionsRemaining       Int
  ngoSuitable             Boolean       @default(false)
  categoryNote            String?       // when category = OTHER: what it refers to (v3.2)
  bulkUnit                String?       // when portionType = BULK_SERVINGS: sub-unit label, e.g. KILOGRAMS (v3.2)
  contactPhone            String?       // donor contact for THIS listing, prefilled from User.mobile (v3.4)
  showContact             Boolean       @default(false) // donor opted to reveal contactPhone on the listing detail (v3.4)
  pickupLat               Float?        // pickup point coordinates (v3.5); the readable address stays in pickupLocationText
  pickupLng               Float?        // both null = location text only, distance unavailable (never treated as 0)
  photoPath               String?
  pickupLocationText      String
  cookedAt                DateTime
  collectionDeadline      DateTime
  checklistConfirmedItems Json          @default("[]")
  checklistConfirmedAt    DateTime?
  status                  ListingStatus @default(DRAFT)
  cancelReason            String?
  // FR-14: at most one near-deadline notification per listing per threshold.
  nearDeadlineProviderNotifiedAt  DateTime?
  nearDeadlineClaimersNotifiedAt  DateTime?
  recurringScheduleId     String?
  recurringSchedule       RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  claims Claim[]

  @@index([status, collectionDeadline])
  @@index([providerId])
}

model Claim {
  id                  String      @id @default(uuid())
  listingId           String
  listing             Listing     @relation(fields: [listingId], references: [id])
  claimerId           String
  claimer             User        @relation("ClaimerClaims", fields: [claimerId], references: [id])
  portionsClaimed     Int
  status              ClaimStatus @default(CONFIRMED)
  // Pickup code storage (PRD FR-11): no plaintext code in any column.
  pickupCodeHash      String?
  pickupCodeSalt      String?
  pickupCodeEncrypted String?
  pickupCodeIv        String?
  pickupCodeAuthTag   String?
  // HMAC-SHA-256(code, server pepper); unique among ACTIVE claims only,
  // because it is cleared (null) at every terminal state. Postgres unique
  // indexes allow multiple NULLs, which is exactly the semantics FR-11 needs.
  pickupCodeHmac      String?     @unique
  verifyFailCount     Int         @default(0)
  verifyLockedUntil   DateTime?
  collectedAt         DateTime?
  // PRD v3.16 (batch F1): set exactly once when the claimer presses
  // "On the way"; the conditional update on this being null is what
  // makes the donor notification exactly-once under concurrency.
  onTheWayAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  liveLocation        LiveLocation?
  redistributionLogs  RedistributionLog[]

  @@index([listingId])
  @@index([claimerId])
}

// Live donor location for one claim (PRD v3.13). ONE row per claim —
// every publish overwrites it, so no location history ever exists.
// Coordinates are nulled when sharing stops; rows for claims that leave
// CONFIRMED are purged by the 60-second job. Never exposed through any
// listing/public payload.
model LiveLocation {
  claimId   String   @id
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model RecurringSchedule {
  id                   String   @id @default(uuid())
  providerId           String
  provider             User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  templateFields       Json
  daysOfWeek           Int[]
  generationTimeLocal  String // "HH:MM", Asia/Kolkata
  deadlineOffsetMinutes Int     @default(180)
  active               Boolean  @default(true)
  lastGeneratedOn      String? // "YYYY-MM-DD" in Asia/Kolkata, prevents duplicate occurrences
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  listings Listing[]
}

model RedistributionLog {
  id              String          @id @default(uuid())
  claimId         String
  claim           Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ngoId           String
  ngo             User            @relation("NgoRedistributions", fields: [ngoId], references: [id])
  destinationName String
  destinationType DestinationType
  portions        Int
  redistributedAt DateTime
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([claimId])
  @@index([ngoId])
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  body            String
  relatedListingId String?
  relatedClaimId   String?
  read            Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  adminId    String
  admin      User        @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action     AuditAction
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([adminId])
}
